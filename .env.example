# Copy this file to ".env" in the project root (next to this file) and fill in the
# real values. Never commit .env.
# TiDB Cloud Starter connection (Cluster > Connect in the TiDB console)
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=tEtqRfJ9HEujbjZ.root
DB_PASSWORD=zdMq2h6D06udbhoK
DB_NAME=Luna_Pharmacy

# TLS: "require" by default (TiDB requires TLS). Use "disable" only for a local MySQL without TLS.
DB_SSL=require
# Optional: paste the CA certificate if your provider requires it
# DB_SSL_CA_PEM=
# DB_SSL_CA=path/to/ca.pem

# Long random string used to sign login sessions (never commit the real value)
SESSION_SECRET=change-me-to-a-long-random-string
